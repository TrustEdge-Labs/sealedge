    "globals": "^17.12.0",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tslib": "^2.4.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "type": "module",
